{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0032-result/v2",
  "title": "HullQ SLICE-0032 Per-Candidate Attempt Status/Result + Top-Level Result",
  "description": "attempt_status and result are deliberately separate concepts. NOT_ATTEMPTED_AFTER_SUCCESS is an attempt_status value, never a fourth candidate result: an ATTEMPTED row must carry one of the three normative results and a positive retrieval_count; a NOT_ATTEMPTED_AFTER_SUCCESS row must carry a null result and retrieval_count 0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "candidates", "total_retrievals", "stop_on_first_positive_invariant", "top_level_result", "successful_rank"],
  "properties": {
    "schema_version": { "const": "sl0032-result-v2" },
    "generated_at": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_rank", "qid", "hullq_id", "attempt_status", "result", "retrieval_count"],
        "properties": {
          "candidate_rank": { "type": "integer", "enum": [1, 2, 3] },
          "qid": { "type": "string", "pattern": "^Q[0-9]+$" },
          "hullq_id": { "type": "string", "minLength": 1 },
          "attempt_status": { "enum": ["ATTEMPTED", "NOT_ATTEMPTED_AFTER_SUCCESS"] },
          "result": {
            "enum": [
              "READY_FOR_BOUNDED_CANONICAL_BOATDESIGN_PILOT",
              "RIGHTS_CLEARANCE_BLOCKED",
              "APPLICABILITY_EVIDENCE_INSUFFICIENT",
              null
            ]
          },
          "retrieval_count": { "type": "integer", "minimum": 0, "maximum": 12 }
        },
        "allOf": [
          {
            "if": { "properties": { "attempt_status": { "const": "ATTEMPTED" } } },
            "then": {
              "properties": {
                "result": {
                  "enum": [
                    "READY_FOR_BOUNDED_CANONICAL_BOATDESIGN_PILOT",
                    "RIGHTS_CLEARANCE_BLOCKED",
                    "APPLICABILITY_EVIDENCE_INSUFFICIENT"
                  ]
                },
                "retrieval_count": { "minimum": 1 }
              }
            }
          },
          {
            "if": { "properties": { "attempt_status": { "const": "NOT_ATTEMPTED_AFTER_SUCCESS" } } },
            "then": {
              "properties": {
                "result": { "const": null },
                "retrieval_count": { "const": 0 }
              }
            }
          }
        ]
      }
    },
    "total_retrievals": { "type": "integer", "minimum": 0, "maximum": 36 },
    "stop_on_first_positive_invariant": { "const": "PASS" },
    "top_level_result": {
      "enum": [
        "READY_FOR_BOUNDED_CANONICAL_BOATDESIGN_PILOT",
        "RIGHTS_CLEARANCE_BLOCKED",
        "APPLICABILITY_EVIDENCE_INSUFFICIENT"
      ]
    },
    "successful_rank": { "type": ["integer", "null"], "enum": [1, 2, 3, null] }
  }
}
