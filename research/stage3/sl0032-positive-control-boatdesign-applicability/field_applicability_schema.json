{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0032-field-applicability/v2",
  "title": "HullQ SLICE-0032 Five-Field Applicability Classification",
  "description": "Contains exactly one row per ATTEMPTED candidate rank (1..3 of them) -- a rank with attempt_status=NOT_ATTEMPTED_AFTER_SUCCESS in result.json carries no row here at all.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "allowed_field_pointers", "candidates"],
  "properties": {
    "schema_version": { "const": "sl0032-field-applicability-v2" },
    "generated_at": { "type": "string", "minLength": 1 },
    "allowed_field_pointers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "pattern": "^/baseline/dimensions/" }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_rank", "qid", "hullq_id", "fields"],
        "properties": {
          "candidate_rank": { "type": "integer", "enum": [1, 2, 3] },
          "qid": { "type": "string", "pattern": "^Q[0-9]+$" },
          "hullq_id": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field_pointer", "outcome", "wikidata_normalized_candidate", "primary_source_value", "applicability_scope", "notes"],
              "properties": {
                "field_pointer": { "type": "string", "pattern": "^/baseline/dimensions/" },
                "outcome": {
                  "enum": [
                    "SAFE_FOR_LATER_DESIGN_PROMOTION",
                    "MODEL_SCOPE_ONLY_NOT_PROMOTABLE",
                    "GENERATION_AMBIGUOUS",
                    "OPTION_SENSITIVE",
                    "SOURCE_VALUE_CONFLICT",
                    "INSUFFICIENT_EVIDENCE",
                    "NO_NORMALIZED_WIKIDATA_CANDIDATE",
                    "RIGHTS_BLOCKED"
                  ]
                },
                "wikidata_normalized_candidate": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["value", "unit"],
                  "properties": { "value": { "type": "string" }, "unit": { "type": "string" } }
                },
                "primary_source_value": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["value", "unit", "raw"],
                  "properties": {
                    "value": { "type": "string" },
                    "unit": { "type": "string" },
                    "raw": { "type": "string", "minLength": 1 }
                  }
                },
                "applicability_scope": { "$ref": "#/$defs/applicability_scope" },
                "notes": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "applicability_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "first_year",
        "last_year",
        "hull_number_from",
        "hull_number_to",
        "market_or_region",
        "named_variant_hint",
        "design_option_hints",
        "operating_state_hint",
        "individual_hull_or_listing_ref",
        "unknown_or_unbounded"
      ],
      "properties": {
        "schema_version": { "const": "0.1" },
        "first_year": { "type": ["integer", "null"] },
        "last_year": { "type": ["integer", "null"] },
        "hull_number_from": { "type": ["string", "null"], "minLength": 1 },
        "hull_number_to": { "type": ["string", "null"], "minLength": 1 },
        "market_or_region": { "type": ["string", "null"], "minLength": 1 },
        "named_variant_hint": { "type": ["string", "null"], "minLength": 1 },
        "design_option_hints": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
        "operating_state_hint": { "type": ["string", "null"], "minLength": 1 },
        "individual_hull_or_listing_ref": { "type": ["string", "null"], "minLength": 1 },
        "unknown_or_unbounded": { "type": "boolean" }
      }
    }
  }
}
