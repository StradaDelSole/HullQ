{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0032-pilot-candidates/v1",
  "title": "HullQ SLICE-0032 Fixed Pilot Candidate Sequence",
  "description": "The fixed, normative rank-1..3 SLICE-0031 positive-control candidate sequence pursued by this pilot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_pool",
    "eligibility_rule",
    "ranking_rule",
    "sequential_rule",
    "max_candidates",
    "max_retrievals_per_candidate",
    "max_total_retrievals",
    "allowed_field_pointers",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": "sl0032-pilot-candidates-v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "source_pool": { "type": "string", "minLength": 1 },
    "eligibility_rule": { "type": "string", "minLength": 1 },
    "ranking_rule": { "type": "string", "minLength": 1 },
    "sequential_rule": { "type": "string", "minLength": 1 },
    "max_candidates": { "const": 3 },
    "max_retrievals_per_candidate": { "const": 12 },
    "max_total_retrievals": { "const": 36 },
    "allowed_field_pointers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "pattern": "^/baseline/dimensions/" }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "qid", "hullq_id", "label"],
        "properties": {
          "rank": { "type": "integer", "enum": [1, 2, 3] },
          "qid": { "type": "string", "pattern": "^Q[0-9]+$" },
          "hullq_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
