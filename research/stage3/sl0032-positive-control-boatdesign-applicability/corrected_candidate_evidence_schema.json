{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0032-corrected-candidate-evidence/v1",
  "title": "HullQ SLICE-0032 Corrected/Current Five-Field Candidate Evidence",
  "description": "Corrected/current normalized five-field technical evidence for the three fixed pilot QIDs, reconstructed offline from the retained SLICE-0028 raw_entities replayed through the SLICE-0030 corrected unit map.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "derivation_note", "unit_map_version", "candidates"],
  "properties": {
    "schema_version": { "const": "sl0032-corrected-candidate-evidence-v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "derivation_note": { "type": "string", "minLength": 1 },
    "unit_map_version": { "const": "SLICE-0030-v1" },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_rank", "qid", "hullq_id", "fields"],
        "properties": {
          "candidate_rank": { "type": "integer", "enum": [1, 2, 3] },
          "qid": { "type": "string", "pattern": "^Q[0-9]+$" },
          "hullq_id": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "field_pointer", "raw", "normalized_candidate"],
              "properties": {
                "evidence_id": { "type": "string", "minLength": 1 },
                "field_pointer": { "type": "string", "pattern": "^/baseline/dimensions/" },
                "raw": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "value", "unit"],
                  "properties": {
                    "kind": { "type": "string" },
                    "value": {},
                    "unit": { "type": ["string", "null"] }
                  }
                },
                "normalized_candidate": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["value", "unit"],
                  "properties": {
                    "value": { "type": "string" },
                    "unit": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
