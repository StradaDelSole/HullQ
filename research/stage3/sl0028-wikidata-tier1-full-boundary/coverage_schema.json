{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0028-coverage/v1",
  "title": "HullQ SLICE-0028 Full-Boundary Source-QID and BoatModel Coverage",
  "description": "Full-boundary per-field coverage at two levels: source-QID (per acquired entity) and canonical-BoatModel (aggregated over every accepted QID mapped to that BoatModel via strongest-available-evidence precedence). A coverage classification only -- never a canonical technical-value choice; no FieldResolution is created.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "boat_model_count",
    "source_qid_count",
    "note",
    "source_qid_level",
    "boat_model_level"
  ],
  "properties": {
    "schema_version": { "const": "sl0028-coverage-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "boat_model_count": { "type": "integer", "minimum": 0 },
    "source_qid_count": { "type": "integer", "minimum": 0 },
    "note": { "type": "string", "minLength": 1 },
    "source_qid_level": { "$ref": "#/$defs/field_coverage" },
    "boat_model_level": { "$ref": "#/$defs/field_coverage" }
  },
  "$defs": {
    "coverage_bucket_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_candidate_present",
        "source_statement_present",
        "unsupported_or_malformed",
        "no_usable_value"
      ],
      "properties": {
        "normalized_candidate_present": { "type": "integer", "minimum": 0 },
        "source_statement_present": { "type": "integer", "minimum": 0 },
        "unsupported_or_malformed": { "type": "integer", "minimum": 0 },
        "no_usable_value": { "type": "integer", "minimum": 0 }
      }
    },
    "field_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loa", "lwl", "beam", "draft", "displacement"],
      "properties": {
        "loa": { "$ref": "#/$defs/coverage_bucket_counts" },
        "lwl": { "$ref": "#/$defs/coverage_bucket_counts" },
        "beam": { "$ref": "#/$defs/coverage_bucket_counts" },
        "draft": { "$ref": "#/$defs/coverage_bucket_counts" },
        "displacement": { "$ref": "#/$defs/coverage_bucket_counts" }
      }
    }
  }
}
