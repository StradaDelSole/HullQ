{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0027-coverage-before-after/v1",
  "title": "HullQ SLICE-0027 Before/After Coverage",
  "description": "Per-field before (accepted SLICE-0026 P642-only extraction) and after (SLICE-0027-amended extraction) coverage over the exact same retained 100-entity sample, using the same four mutually exclusive SLICE-0026 coverage states.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "sample_size", "note", "fields"],
  "properties": {
    "schema_version": { "const": "sl0027-coverage-before-after-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "sample_size": { "type": "integer", "minimum": 0 },
    "note": { "type": "string", "minLength": 1 },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loa", "lwl", "beam", "draft", "displacement"],
      "properties": {
        "loa": { "$ref": "#/$defs/before_after" },
        "lwl": { "$ref": "#/$defs/before_after" },
        "beam": { "$ref": "#/$defs/before_after" },
        "draft": { "$ref": "#/$defs/before_after" },
        "displacement": { "$ref": "#/$defs/before_after" }
      }
    }
  },
  "$defs": {
    "coverage_bucket_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_candidate_present",
        "source_statement_present",
        "unsupported_or_malformed",
        "no_usable_value"
      ],
      "properties": {
        "normalized_candidate_present": { "type": "integer", "minimum": 0 },
        "source_statement_present": { "type": "integer", "minimum": 0 },
        "unsupported_or_malformed": { "type": "integer", "minimum": 0 },
        "no_usable_value": { "type": "integer", "minimum": 0 }
      }
    },
    "before_after": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/coverage_bucket_counts" },
        "after": { "$ref": "#/$defs/coverage_bucket_counts" }
      }
    }
  }
}
