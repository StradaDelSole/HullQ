{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0029-source-clearance-assessment/v1",
  "title": "HullQ SLICE-0029 Catalina Source-Rights Clearance Assessment",
  "description": "SR-6.6 condition-by-condition evidence, a schema-valid SOURCE_SCHEMA.v0.2 Source record, and the record's outcome under the unmodified hullq.sources.rights.check_source_use gate for all seven use keys. The 'source_record' property additionally MUST validate against specs/SOURCE_SCHEMA.v0.2.json, checked separately by the SLICE-0029 offline verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "predecessor_assessment",
    "sr_6_6_condition_evaluation",
    "source_record",
    "bounded_scope",
    "source_use_gate_decisions",
    "scope_guardrail_confirmation"
  ],
  "properties": {
    "schema_version": { "const": "sl0029-source-clearance-assessment-v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "predecessor_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_key", "note"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "source_key": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "sr_6_6_condition_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_reference", "conditions", "conditions_satisfied_for_bounded_manual_use"],
      "properties": {
        "policy_reference": { "const": "specs/SOURCE_RIGHTS_POLICY.v0.1.md#6.6" },
        "conditions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition", "satisfied", "evidence"],
            "properties": {
              "condition": { "type": "string", "minLength": 1 },
              "satisfied": {
                "anyOf": [{ "type": "boolean" }, { "const": "partial_left_unresolved" }]
              },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "conditions_satisfied_for_bounded_manual_use": { "type": "boolean" }
      }
    },
    "source_record": {
      "type": "object",
      "description": "MUST additionally validate against specs/SOURCE_SCHEMA.v0.2.json (checked separately)."
    },
    "bounded_scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "The exact QIDs/hullq_ids/field pointers/use kinds the positive identity_seed/production_value clearance applies to. MUST equal the fixed pilot identity boundary and the five fixed Tier-1 field pointers; checked by hullq.bootstrap.wikidata_sl0029_boatdesign_applicability_pilot.validate_bounded_scope.",
      "required": ["hullq_ids", "qids", "field_pointers", "use_kinds", "note"],
      "properties": {
        "hullq_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "qids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^Q[1-9][0-9]*$" }
        },
        "field_pointers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "pattern": "^/baseline/dimensions/" }
        },
        "use_kinds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "enum": ["identity_seed", "production_value"] }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "source_use_gate_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_module", "note", "decisions"],
      "properties": {
        "gate_module": { "const": "hullq.sources.rights.check_source_use" },
        "note": { "type": "string", "minLength": 1 },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "research_reference",
            "research_lead",
            "identity_seed",
            "production_value",
            "bulk_bootstrap",
            "automated_ingestion",
            "artifact_redistribution"
          ],
          "properties": {
            "research_reference": { "$ref": "#/$defs/decision" },
            "research_lead": { "$ref": "#/$defs/decision" },
            "identity_seed": { "$ref": "#/$defs/decision" },
            "production_value": { "$ref": "#/$defs/decision" },
            "bulk_bootstrap": { "$ref": "#/$defs/decision" },
            "automated_ingestion": { "$ref": "#/$defs/decision" },
            "artifact_redistribution": { "$ref": "#/$defs/decision" }
          }
        }
      }
    },
    "scope_guardrail_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_clearance_uses", "unchanged_non_allow_uses", "note"],
      "properties": {
        "positive_clearance_uses": { "type": "array", "items": { "type": "string" } },
        "unchanged_non_allow_uses": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": [
            "allowed",
            "blocked",
            "legal_review_required",
            "conditional",
            "unknown_unassessed"
          ]
        }
      }
    }
  }
}
