{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/sl0026-evidence-manifest/v1",
  "title": "HullQ SLICE-0026 Bounded Wikidata Tier-1 Enrichment Pilot Evidence Manifest",
  "description": "Retained Tier-1 (LOA/LWL/beam/draft/displacement) evidence for exactly 100 pilot BoatModels, acquired via the existing rights-gated Wikidata adapter for known QIDs only. Includes trimmed raw-entity data sufficient to fully reproduce every derived value offline (zero network access).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "acquired_at",
    "source_id",
    "activity_id",
    "allowed_field_pointers",
    "usage_metrics",
    "quality_report_global",
    "field_coverage",
    "boat_models",
    "raw_entities"
  ],
  "properties": {
    "schema_version": { "const": "sl0026-evidence-manifest-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "acquired_at": { "type": "string", "minLength": 1 },
    "source_id": { "const": "SRC_WIKIDATA_API_2026" },
    "activity_id": { "type": "string", "minLength": 1 },
    "allowed_field_pointers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "pattern": "^/baseline/dimensions/" }
    },
    "usage_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_qid_count", "fetched_entity_count", "retrieval_count_attributed"],
      "properties": {
        "requested_qid_count": { "type": "integer", "minimum": 0 },
        "fetched_entity_count": { "type": "integer", "minimum": 0 },
        "retrieval_count_attributed": { "type": "integer", "minimum": 0 }
      }
    },
    "quality_report_global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["malformed_statement_count", "unsupported_qualifier_count", "note"],
      "properties": {
        "malformed_statement_count": { "type": "integer", "minimum": 0 },
        "unsupported_qualifier_count": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "field_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loa", "lwl", "beam", "draft", "displacement"],
      "properties": {
        "loa": { "$ref": "#/$defs/coverage_bucket_counts" },
        "lwl": { "$ref": "#/$defs/coverage_bucket_counts" },
        "beam": { "$ref": "#/$defs/coverage_bucket_counts" },
        "draft": { "$ref": "#/$defs/coverage_bucket_counts" },
        "displacement": { "$ref": "#/$defs/coverage_bucket_counts" }
      }
    },
    "boat_models": {
      "type": "array",
      "items": { "$ref": "#/$defs/boat_model_evidence" }
    },
    "raw_entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/raw_entity" }
    }
  },
  "$defs": {
    "coverage_bucket_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_candidate_present",
        "source_statement_present",
        "unsupported_or_malformed",
        "no_usable_value"
      ],
      "properties": {
        "normalized_candidate_present": { "type": "integer", "minimum": 0 },
        "source_statement_present": { "type": "integer", "minimum": 0 },
        "unsupported_or_malformed": { "type": "integer", "minimum": 0 },
        "no_usable_value": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "field_pointer",
        "subject_kind",
        "subject_qid",
        "raw",
        "normalized_candidate"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "field_pointer": { "type": "string", "pattern": "^/baseline/dimensions/" },
        "subject_kind": { "type": "string" },
        "subject_qid": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": { "type": "string" },
            "value": {},
            "unit": { "type": ["string", "null"] }
          }
        },
        "normalized_candidate": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "string" },
            "unit": { "type": "string" }
          }
        }
      }
    },
    "boat_model_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hullq_id", "qid", "bundle_id", "evidence"],
      "properties": {
        "hullq_id": { "type": "string", "minLength": 1 },
        "qid": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
        "bundle_id": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/evidence_item" }
        }
      }
    },
    "raw_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qid", "label", "aliases", "raw_claims"],
      "properties": {
        "qid": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
        "label": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "raw_claims": { "type": "object" }
      }
    }
  }
}
