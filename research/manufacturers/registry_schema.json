{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/manufacturer-research-registry/0019-v1",
  "title": "HullQ SLICE-0019 Global Series-Sailboat Manufacturer/Yard Research Registry",
  "description": "Non-canonical research artifact. Records here are research leads/candidates about real-world manufacturer/yard/brand entities discovered while mapping the global series-sailboat manufacturer universe. This schema and its records MUST NOT be interpreted as, or reused as, canonical HullQ Brand/Organization/BoatModel/BoatDesign identity. `research_record_id` is a stable research-only identifier and is never a HullQ canonical ID. No field in this document authorizes production ingestion by itself; see each record's `rights_assessment` for later systematic-use status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "generated_at", "slice_id", "source_note", "records"],
  "properties": {
    "registry_version": { "const": "0019-v1" },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this registry document was most recently (re)written."
    },
    "slice_id": { "const": "SLICE-0019" },
    "source_note": {
      "type": "string",
      "description": "Short human-readable note on how this registry was produced (research method summary)."
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/manufacturer_research_record" }
    }
  },
  "$defs": {
    "manufacturer_research_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_record_id",
        "preferred_display_name",
        "aliases",
        "entity_kind",
        "country",
        "region",
        "status",
        "production_era",
        "relationships",
        "series_production_evidence",
        "official_current_site",
        "official_heritage_archive",
        "other_archive_sources",
        "sources",
        "rights_assessment",
        "model_identity_yield",
        "production_unit_count",
        "research_status",
        "ambiguity_notes",
        "source_yield_sample"
      ],
      "properties": {
        "research_record_id": {
          "type": "string",
          "pattern": "^RSRCH-MFR-[0-9]{4}$",
          "description": "Stable research-only identifier. Never a canonical HullQ ID and never reused as one."
        },
        "preferred_display_name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "entity_kind": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["manufacturer", "yard", "brand", "legal_organization"]
          },
          "description": "One or more roles evidenced for this entity. A record with more than one kind, or whose kind is ambiguous relative to a related record, MUST explain the distinction in ambiguity_notes rather than silently collapsing identities."
        },
        "country": { "type": ["string", "null"] },
        "region": {
          "type": "string",
          "enum": [
            "North America",
            "UK & Ireland",
            "Western Europe",
            "Nordics",
            "Southern Europe",
            "Eastern Europe",
            "Asia-Pacific",
            "Rest of World"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["active", "historical", "defunct", "acquired", "renamed", "unknown"]
        },
        "production_era": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_year", "end_year", "basis"],
          "properties": {
            "start_year": { "type": ["integer", "null"] },
            "end_year": { "type": ["integer", "null"] },
            "basis": { "type": "string", "enum": ["exact", "estimated", "unknown"] }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "related_name", "evidence_note", "source_url"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "predecessor",
                  "successor",
                  "acquired_by",
                  "formerly_known_as",
                  "brand_owned_by",
                  "production_transferred_to",
                  "other"
                ]
              },
              "related_name": { "type": "string", "minLength": 1 },
              "evidence_note": { "type": "string" },
              "source_url": { "type": ["string", "null"] }
            }
          }
        },
        "series_production_evidence": { "type": "string" },
        "official_current_site": { "type": ["string", "null"] },
        "official_heritage_archive": { "type": ["string", "null"] },
        "other_archive_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "title", "source_type", "retrieved_at"],
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "source_type": {
                "type": "string",
                "enum": [
                  "official_site",
                  "official_heritage_archive",
                  "brochure_manual",
                  "designer_archive",
                  "class_or_owners_association",
                  "museum_or_archive",
                  "industry_association",
                  "wikidata",
                  "web_archive",
                  "specialist_secondary",
                  "other"
                ]
              },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "rights_assessment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_url",
              "public_access",
              "robots_or_api_notes",
              "license_evidence",
              "discovery_use_acceptable",
              "systematic_use_status",
              "review_date"
            ],
            "properties": {
              "source_url": { "type": "string", "minLength": 1 },
              "public_access": {
                "type": "string",
                "enum": ["public", "registration_required", "paywalled", "unknown"]
              },
              "robots_or_api_notes": { "type": ["string", "null"] },
              "license_evidence": { "type": ["string", "null"] },
              "discovery_use_acceptable": { "type": "boolean" },
              "systematic_use_status": {
                "type": "string",
                "enum": ["CLEARED", "REQUIRES_REVIEW", "BLOCKED", "UNKNOWN"],
                "description": "Whether later systematic/bulk commercial ingestion from this exact source appears cleared. This assessment is separate from mere public readability and MUST NOT be set to CLEARED merely because a page is publicly viewable."
              },
              "review_date": { "type": "string", "format": "date" }
            }
          }
        },
        "model_identity_yield": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "basis", "notes"],
          "description": "Count of discoverable/distinct production-sailboat model identities (e.g. 'Oyster lists 46 heritage models'). This is never a cumulative hull/unit count; see production_unit_count for that.",
          "properties": {
            "value": { "type": ["integer", "null"], "minimum": 0 },
            "basis": { "type": "string", "enum": ["exact", "estimated", "unknown"] },
            "notes": { "type": "string" }
          }
        },
        "production_unit_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "basis", "notes"],
          "description": "Cumulative company/model production-unit (hull) count claimed by a source (e.g. 'more than 85,000 Catalinas on the water'). This is never a count of distinct model identities; see model_identity_yield for that.",
          "properties": {
            "value": { "type": ["integer", "null"], "minimum": 0 },
            "basis": { "type": "string", "enum": ["exact", "estimated", "unknown"] },
            "notes": { "type": "string" }
          }
        },
        "research_status": {
          "type": "string",
          "enum": ["discovered", "eligible", "verified", "needs_review", "excluded"],
          "description": "discovered = named as a lead but not deeply checked; eligible = passed inclusion-criteria screening; verified = solid single-authoritative or multi-source evidence supports series-production eligibility and the recorded facts; needs_review = thin/ambiguous/conflicting evidence; excluded = checked and found ineligible (retained for audit trail, see ambiguity_notes)."
        },
        "ambiguity_notes": { "type": ["string", "null"] },
        "source_yield_sample": {
          "type": "boolean",
          "description": "True only for the 20 entities deliberately selected for the SLICE-0019 source-yield study; see REPORT.md for the measured yield characteristics of each."
        }
      }
    }
  }
}
