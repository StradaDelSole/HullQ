{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/wikidata-tier0-bootstrap-manifest/0017-v4",
  "title": "HullQ SLICE-0017 Wikidata Tier-0 Bootstrap Manifest",
  "description": "Versioned, replayable record of one controlled Wikidata Tier-0 identity bootstrap run. `candidates` holds only the current bounded discovery/classification window; `retained_crosswalk` is the separate, independent historical QID->HullQ-ID registry that accumulates across runs so a QID absent from one discovery window is never lost or silently reminted. Retains the exact acquisition path/version and complete same-search-key collision clusters for the current window, and replays offline against PostgreSQL without live network access. Does not contain SailboatData values or unrelated third-party content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "source_id",
    "generated_at",
    "acquired_at",
    "classification_recomputed_at",
    "requested_limit",
    "safety_ceiling",
    "discovery",
    "usage_metrics",
    "candidates",
    "retained_crosswalk",
    "collision_clusters",
    "counts"
  ],
  "properties": {
    "manifest_version": { "const": "0017-v4" },
    "source_id": { "type": "string", "minLength": 1 },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this manifest document was most recently (re)written — a live run or an offline recompute both update this."
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time",
      "description": "The original live Wikidata acquisition timestamp. MUST be preserved verbatim across every later offline reclassification; MUST NOT be replaced by a recompute's own timestamp."
    },
    "classification_recomputed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Null for a manifest that has never been offline-reclassified since its original live acquisition. Set to the timestamp of the most recent --recompute pass otherwise."
    },
    "requested_limit": { "type": "integer", "minimum": 1 },
    "safety_ceiling": { "type": "integer", "minimum": 1 },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_qids_returned",
        "candidates_processed",
        "fetched_entity_count",
        "target_reached",
        "acquisition_failure_count",
        "sparql_query_version",
        "sparql_endpoint",
        "entity_api_endpoint",
        "entity_api_version"
      ],
      "properties": {
        "unique_qids_returned": { "type": "integer", "minimum": 0 },
        "candidates_processed": { "type": "integer", "minimum": 0 },
        "fetched_entity_count": { "type": "integer", "minimum": 0 },
        "target_reached": { "type": "boolean" },
        "acquisition_failure_count": { "type": "integer", "minimum": 0 },
        "sparql_query_version": { "type": "string", "minLength": 1 },
        "sparql_endpoint": { "type": "string", "minLength": 1 },
        "entity_api_endpoint": { "type": "string", "minLength": 1 },
        "entity_api_version": { "type": "string", "minLength": 1 }
      }
    },
    "usage_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_count", "extracted_record_count"],
      "properties": {
        "retrieval_count": { "type": "integer", "minimum": 0 },
        "extracted_record_count": { "type": "integer", "minimum": 0 }
      }
    },
    "candidates": {
      "type": "array",
      "description": "Only the current bounded discovery/classification window. Never includes a QID carried forward merely because an earlier run once classified it — see retained_crosswalk for that.",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "retained_crosswalk": {
      "type": "array",
      "description": "The complete historical QID -> HullQ-ID registry, a superset of the current candidates' own mappings. A QID absent from the current candidates window remains here so it is never silently reminted if it reappears in a later run.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["qid", "hullq_id"],
        "properties": {
          "qid": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
          "hullq_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "collision_clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/collision_cluster" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates_processed",
        "auto_admit",
        "review_required",
        "not_admitted",
        "reason_breakdown",
        "collision_cluster_count",
        "retained_crosswalk_count",
        "research_observation_count",
        "canonical_evidence_link_count"
      ],
      "properties": {
        "candidates_processed": { "type": "integer", "minimum": 0 },
        "auto_admit": { "type": "integer", "minimum": 0 },
        "review_required": { "type": "integer", "minimum": 0 },
        "not_admitted": { "type": "integer", "minimum": 0 },
        "reason_breakdown": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "collision_cluster_count": { "type": "integer", "minimum": 0 },
        "retained_crosswalk_count": { "type": "integer", "minimum": 0 },
        "research_observation_count": { "type": "integer", "minimum": 0 },
        "canonical_evidence_link_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qid",
        "retrieved_at",
        "preferred_label",
        "aliases",
        "hullq_id",
        "decision",
        "reason_codes",
        "observation_id",
        "bundle_id",
        "bundle_version",
        "evidence_link_id"
      ],
      "properties": {
        "qid": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "preferred_label": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "hullq_id": {
          "type": ["string", "null"],
          "description": "Stable opaque HullQ ID. MAY be non-null even for a review_required/not_admitted candidate: a previously admitted QID that this run newly routes to review retains its historical ID as a reserved record rather than being silently reminted; it does not by itself indicate a current canonical admission (see decision)."
        },
        "decision": {
          "enum": ["auto_admit", "review_required", "not_admitted"]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "enum": ["ok", "missing_label", "name_collision", "crosswalk_conflict"]
          }
        },
        "observation_id": { "type": ["string", "null"] },
        "bundle_id": { "type": ["string", "null"] },
        "bundle_version": { "type": ["string", "null"] },
        "evidence_link_id": { "type": ["string", "null"] }
      }
    },
    "collision_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qids", "shared_keys"],
      "description": "A complete group of two or more distinct QIDs whose accepted deterministic search-key projection (hullq.domain.identity.generate_search_keys over canonical label + retained aliases) overlaps on at least one key. Every member routes to review_required.",
      "properties": {
        "qids": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "pattern": "^Q[1-9][0-9]*$" }
        },
        "shared_keys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
