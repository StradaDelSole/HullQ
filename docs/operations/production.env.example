# SLICE-0079 production environment template.
#
# Copy to `.env` on the application VPS next to docker-compose.prod.yml
# (never commit the real `.env` -- it is covered by the repository
# .gitignore's `.env.*` rule). See
# docs/operations/PRODUCTION_DEPLOY_ROLLBACK_RUNBOOK.md for how each
# value is obtained/rotated.

# --- Deploy ---
# Set by scripts/ops/deploy.sh / rollback.sh at deploy time; not normally
# hand-edited.
HULLQ_IMAGE_TAG=

# --- Database (DigitalOcean Managed PostgreSQL 18, FRA1) ---
HULLQ_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Preview-link signing (SLICE-0048) ---
HULLQ_PREVIEW_SIGNING_SECRET=

# --- Broker session (SLICE-0053) ---
HULLQ_SESSION_SIGNING_SECRET=
HULLQ_AUTH_REDIRECT_URI=https://hullq.com/api/auth/callback
HULLQ_WEB_BASE_URL=https://hullq.com
HULLQ_WEB_ORIGIN=https://hullq.com
HULLQ_SESSION_COOKIE_SECURE=true

# --- Auth0 (EU tenant, authentication-only) ---
HULLQ_AUTH0_DOMAIN=
HULLQ_AUTH0_CLIENT_ID=
HULLQ_AUTH0_CLIENT_SECRET=

# --- Marketplace media object storage (Cloudflare R2, SLICE-0068) ---
HULLQ_R2_ACCOUNT_ID=
HULLQ_R2_ACCESS_KEY_ID=
HULLQ_R2_SECRET_ACCESS_KEY=
HULLQ_R2_BUCKET=

# --- Backup object storage (Cloudflare R2 -- SEPARATE bucket/credentials
# from media above; see docs/ARCHITECTURE_REBASELINE_2026-09-02.md §21/§22) ---
HULLQ_BACKUP_R2_ACCOUNT_ID=
HULLQ_BACKUP_R2_ACCESS_KEY_ID=
HULLQ_BACKUP_R2_SECRET_ACCESS_KEY=
HULLQ_BACKUP_R2_BUCKET=
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HULLQ_BACKUP_ENCRYPTION_KEY=

# --- Observability / alerting (SLICE-0079) ---
# A Slack incoming-webhook or Discord webhook URL. Leave unset only during
# a strictly internal phase with no operator depending on alert delivery.
HULLQ_ALERT_WEBHOOK_URL=
