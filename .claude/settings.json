{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin slice/*)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose build *)",
      "Bash(docker compose up *)",
      "PowerShell(uv *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git fetch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push origin slice/*)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run watch *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test *)",
      "PowerShell(docker ps *)",
      "PowerShell(docker logs *)",
      "PowerShell(docker compose ps *)",
      "PowerShell(docker compose build *)",
      "PowerShell(docker compose up *)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git switch main *)",
      "Bash(git checkout main *)",
      "Bash(rm *)",
      "Bash(uv run alembic downgrade *)",
      "Bash(docker compose down -v *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push origin main *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git switch main *)",
      "PowerShell(git checkout main *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(uv run alembic downgrade *)",
      "PowerShell(docker compose down -v *)",
      "Bash(git push *:main*)",
      "Bash(git push *--delete*)",
      "Bash(git commit --amend *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git commit --amend *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch -d *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/scripts/workflow/claude_command_guard.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/scripts/workflow/claude_command_guard.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
