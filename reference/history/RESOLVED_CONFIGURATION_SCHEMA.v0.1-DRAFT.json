{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/resolved-configuration/0.1-draft",
  "title": "HullQ ResolvedConfiguration \u2014 draft projection",
  "description": "Deterministic derived projection of a BoatDesign baseline plus optional NamedVariant and compatible DesignOptions. Not canonical source data and not necessarily persisted. Ratio formulas remain blocked by OQ-001.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boat_design_id",
    "named_variant_id",
    "selected_option_ids",
    "effective",
    "derived_ratios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "boat_design_id": {
      "type": "string",
      "minLength": 1
    },
    "named_variant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_option_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "configuration",
        "construction",
        "cruising"
      ],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loa_m",
            "lwl_m",
            "beam_m",
            "draft_min_m",
            "draft_max_m",
            "displacement_kg",
            "ballast_kg",
            "sail_area_m2"
          ],
          "properties": {
            "loa_m": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "lwl_m": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "beam_m": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "draft_min_m": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "draft_max_m": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "displacement_kg": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "ballast_kg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "sail_area_m2": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hull_configuration",
            "hull_count",
            "keel_type",
            "keel_subtype",
            "rudder_type",
            "rudder_count",
            "skeg_type",
            "rig_type",
            "daggerboard_count",
            "centerboard_count"
          ],
          "properties": {
            "hull_configuration": {
              "enum": [
                "monohull",
                "catamaran",
                "trimaran",
                "other",
                "unknown"
              ]
            },
            "hull_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "keel_type": {
              "enum": [
                "full",
                "modified_full",
                "long_fin",
                "fin",
                "wing",
                "bulb",
                "twin",
                "bilge",
                "centerboard",
                "daggerboard",
                "swing",
                "lifting",
                "shoal",
                "other",
                "unknown"
              ]
            },
            "keel_subtype": {
              "type": [
                "string",
                "null"
              ]
            },
            "rudder_type": {
              "enum": [
                "keel_hung",
                "skeg_hung",
                "partial_skeg",
                "spade",
                "transom_hung",
                "twin",
                "other",
                "unknown"
              ]
            },
            "rudder_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "skeg_type": {
              "enum": [
                "full",
                "partial",
                "none",
                "unknown"
              ]
            },
            "rig_type": {
              "enum": [
                "masthead_sloop",
                "fractional_sloop",
                "cutter",
                "ketch",
                "yawl",
                "schooner",
                "cat_rig",
                "other",
                "unknown"
              ]
            },
            "daggerboard_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "centerboard_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "construction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hull_material",
            "construction_method"
          ],
          "properties": {
            "hull_material": {
              "enum": [
                "grp_fiberglass",
                "aluminium",
                "steel",
                "wood",
                "wood_composite",
                "carbon",
                "other",
                "unknown"
              ]
            },
            "construction_method": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "cruising": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine_make",
            "engine_model",
            "engine_type",
            "engine_power_hp",
            "fuel_capacity_l",
            "water_capacity_l",
            "headroom_m",
            "bridgedeck_clearance_m"
          ],
          "properties": {
            "engine_make": {
              "type": [
                "string",
                "null"
              ]
            },
            "engine_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "engine_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "engine_power_hp": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "fuel_capacity_l": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "water_capacity_l": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "headroom_m": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "bridgedeck_clearance_m": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "derived_ratios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sa_displ",
        "ballast_displ_pct",
        "displ_length",
        "comfort_ratio",
        "capsize_screening_formula",
        "hull_speed_kn",
        "formula_version"
      ],
      "properties": {
        "sa_displ": {
          "type": [
            "number",
            "null"
          ]
        },
        "ballast_displ_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "displ_length": {
          "type": [
            "number",
            "null"
          ]
        },
        "comfort_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "capsize_screening_formula": {
          "type": [
            "number",
            "null"
          ]
        },
        "hull_speed_kn": {
          "type": [
            "number",
            "null"
          ]
        },
        "formula_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
