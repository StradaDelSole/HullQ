{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/boat-model/0.1",
  "title": "HullQ BoatModel Identity",
  "description": "Accepted OQ-003 BoatModel identity envelope. A BoatModel is one continuous commercial model lineage; technical generations are separate BoatDesign records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "canonical_name",
    "manufacturer_name",
    "brand_name",
    "aliases",
    "first_built",
    "last_built",
    "boat_design_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "first_built": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2200
    },
    "last_built": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2200
    },
    "boat_design_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
