{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hullq.local/schemas/market-listing/0.1",
  "title": "HullQ Canonical Market Listing",
  "description": "DRAFT adapter-output contract. Not all fields are guaranteed by every source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "source_listing_id",
    "url",
    "title",
    "observed_at",
    "raw_identity",
    "matched_boat_design_id",
    "year",
    "price",
    "location",
    "seller"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "source_listing_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "raw_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "model",
        "variant"
      ],
      "properties": {
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "matched_boat_design_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "country_code"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "country_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "seller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "broker",
            "dealer",
            "private",
            "unknown"
          ]
        }
      }
    }
  }
}
