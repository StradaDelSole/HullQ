        "required": true,
        "notes": null,
        "components": null
      },
      "category": {
        "data_type": "categorical",
        "values": [
          "RIGGING",
          "SAILS",
          "ENGINE_PROPULSION",
          "ELECTRICAL_ENERGY",
          "NAVIGATION",
          "HULL",
          "DECK",
          "PLUMBING",
          "HVAC_COMFORT",
          "INTERIOR",
          "SAFETY",
          "OTHER"
        ],
        "required": true,
        "notes": "Bounded Gate-1 category vocabulary; not free text.",
        "components": null
      },
      "topic": {
        "data_type": "string",
        "values": null,
        "required": true,
        "notes": "Non-empty text or bounded identifier naming the specific item.",
        "components": null
      },
      "action": {
        "data_type": "categorical",
        "values": [
          "INSTALLED",
          "REPLACED",
          "REFURBISHED",
          "UPGRADED",
          "REPAIRED",
          "OTHER"
        ],
        "required": true,
        "notes": null,
        "components": null
      },
      "timing": {
        "data_type": "timing_structure",
        "values": null,
        "required": true,
        "notes": "precision selects which payload component(s) are populated. EXACT requires exactly one of exact_year/exact_date (not neither, not both) and forbids approximate_period. APPROXIMATE requires a non-empty, non-whitespace-only approximate_period and forbids exact_year/exact_date. UNKNOWN forbids all three payload components (no fabricated precision).",
        "components": {
          "precision": {
            "data_type": "categorical",
            "values": [
              "EXACT",
              "APPROXIMATE",
              "UNKNOWN"
            ],
            "required": true,
            "notes": null
          },
          "exact_year": {
            "data_type": "integer",
            "values": null,
            "required": false,
            "notes": "Non-null only when precision=EXACT. Exactly one of exact_year/exact_date must be non-null when precision=EXACT -- never both, never neither."
          },
          "exact_date": {
            "data_type": "string",
            "values": null,
            "required": false,
            "notes": "A valid ISO 8601 calendar date (not merely any string). Non-null only when precision=EXACT. Exactly one of exact_year/exact_date must be non-null when precision=EXACT -- never both, never neither."
          },
          "approximate_period": {
            "data_type": "string",
            "values": null,
            "required": false,
            "notes": "Non-empty, non-whitespace-only text, only when precision=APPROXIMATE; required in that case."
          }
        }
      },
      "description": {
        "data_type": "free_text",
        "values": null,
        "required": false,
        "notes": "Optional short text.",
        "components": null
      },
