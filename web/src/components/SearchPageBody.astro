---
// SLICE-0051: the one shared Search page presentation for every supported
// locale. Purely presentational -- props in, HTML out. It never fetches
// anything and never mutates `Astro.response`/`Astro.redirect`: those calls
// must happen in the top-level page's own frontmatter (see
// `web/src/lib/searchPageData.ts`'s docstring for why), before this
// component ever renders. Each `web/src/pages/{locale}/search.astro` route
// is a thin wrapper around this component.
//
// SLICE-0056: renders all three accepted active-requirement states
// (draft-only, keel-only, mixed). Draft-only confirmed matches keep the
// exact SLICE-0051/0052 `resolved_draft_m` rendering (Required Behavior §D
// non-regression); keel-only/mixed confirmed matches instead read the
// SLICE-0055 typed `criterion_evidence` -- never re-running Search truth or
// reconstructing a value from design-level evidence.
import {
  SEARCH_COCKPIT_POSITION_VALUES,
  SEARCH_DECK_SALOON_VALUES,
  SEARCH_HULL_CONFIGURATION_VALUES,
  SEARCH_KEEL_CONFIGURATION_VALUES,
  SEARCH_RUDDER_CONFIGURATION_VALUES,
  type DraftOnlyConfirmedMatch,
  type NativeInventoryConfirmedMatch,
  type SearchLeafCriterion,
} from "../lib/searchApi";
import type { SearchPageData } from "../lib/searchPageData";
import { searchText, type SupportedLocale } from "../lib/searchText";
import { shortlistText } from "../lib/shortlistText";

// The page's own frontmatter always intercepts `{ kind: "redirect" }` with
// `return Astro.redirect(...)` before this component ever renders (see
// searchPageData.ts's docstring) -- excluding it here lets every remaining
// branch below narrow cleanly between "invalid" and "ok".
type RenderableSearchPageData = Exclude<SearchPageData, { kind: "redirect" }>;

interface Props {
  locale: SupportedLocale;
  data: RenderableSearchPageData;
  canonicalUrl: string;
}

const { locale, data, canonicalUrl } = Astro.props;
const t = searchText[locale];
const st = shortlistText[locale];
const isCanonical = data.kind === "ok";

// The active requirement fully determines which confirmed-match response
// shape FastAPI returned (searchApi.ts's docstring) -- any request involving
// `keel_configuration`/`loa_min`/`loa_max`/`rudder_configuration` (SLICE-0085)
// always uses the SLICE-0055 typed-evidence shape, a pure `draft_max`
// request always keeps the SLICE-0051 `resolved_draft_m` shape. Never
// inferred from an individual match.
const activeRequirement = data.kind === "ok" ? data.activeRequirement : null;
const usesTypedEvidenceShape =
  activeRequirement !== null &&
  (activeRequirement.keel_configuration !== undefined ||
    activeRequirement.loa_min !== undefined ||
    activeRequirement.loa_max !== undefined ||
    activeRequirement.rudder_configuration !== undefined ||
    activeRequirement.hull_configuration !== undefined ||
    activeRequirement.cockpit_position !== undefined ||
    activeRequirement.deck_saloon !== undefined);
// Retained alias: the three originally accepted shapes (draft-only,
// keel-only, draft+keel) keep rendering through the exact same byte-for-byte
// unchanged branches below (Required Behavior non-regression).
const isKeelActive = usesTypedEvidenceShape;
// Whether this is one of the three *originally accepted* active-requirement
// shapes (no LOA/rudder/SLICE-0086 facet active) -- used only to pick the
// legacy fixed-shape `requirementSummary*` text vs. the generic composition,
// never to change which confirmed-match response shape is read above.
const isLegacySummaryShape =
  activeRequirement !== null &&
  activeRequirement.loa_min === undefined &&
  activeRequirement.loa_max === undefined &&
  activeRequirement.rudder_configuration === undefined &&
  activeRequirement.hull_configuration === undefined &&
  activeRequirement.cockpit_position === undefined &&
  activeRequirement.deck_saloon === undefined;

function keelLabel(value: string): string {
  return (t.keelConfigurationLabels as Record<string, string>)[value] ?? value;
}

function rudderLabel(value: string): string {
  return (t.rudderConfigurationLabels as Record<string, string>)[value] ?? value;
}

function hullLabel(value: string): string {
  return (t.hullConfigurationLabels as Record<string, string>)[value] ?? value;
}

function cockpitLabel(value: string): string {
  return (t.cockpitPositionLabels as Record<string, string>)[value] ?? value;
}

function deckSaloonLabel(value: string): string {
  return (t.deckSaloonLabels as Record<string, string>)[value] ?? value;
}

// PR #349 independent-review Finding D: the design/configuration-level
// evidence rendering below needs the exact same "requested condition" text
// the already-reviewed private broker Search-fit page produces
// (`web/src/pages/broker/.../edit.astro`'s own `describeCriterion`) --
// technical field/comparison/value tokens stay language-neutral verbatim
// (item K), never re-translated or re-derived from explanation text.
function describeCriterion(criterion: SearchLeafCriterion): string {
  if (criterion.kind === "NUMERIC") {
    if (criterion.comparison === "MAXIMUM") {
      return `${criterion.field} <= ${criterion.threshold_max}`;
    }
    if (criterion.comparison === "MINIMUM") {
      return `${criterion.field} >= ${criterion.threshold_min}`;
    }
    return `${criterion.field} in [${criterion.threshold_min}, ${criterion.threshold_max}]`;
  }
  return `${criterion.field} = ${criterion.equals}`;
}

function truthLabel(truth: "TRUE" | "FALSE" | "UNKNOWN"): string {
  if (truth === "TRUE") return t.truthTrueLabel;
  if (truth === "FALSE") return t.truthFalseLabel;
  return t.truthUnknownLabel;
}

function draftEvidenceText(match: NativeInventoryConfirmedMatch): string | null {
  const evidence = match.criterion_evidence.find((item) => item.field === "draft_max_m");
  if (evidence === undefined || evidence.observed_value === null) {
    return null;
  }
  return t.resolvedDraftText(evidence.observed_value);
}

function keelEvidenceText(match: NativeInventoryConfirmedMatch): string | null {
  const evidence = match.criterion_evidence.find((item) => item.field === "keel_configuration");
  if (evidence === undefined || evidence.observed_value === null) {
    return null;
  }
  return t.resolvedKeelText(keelLabel(evidence.observed_value));
}

function loaEvidenceText(match: NativeInventoryConfirmedMatch): string | null {
  // loa_min/loa_max may each contribute their own criterion_evidence entry
  // against the shared "loa_m" field -- any one of them already carries the
  // same safely observed concrete value (contract: "retaining both
  // requested comparisons and their evidence"), so the first with a value
  // is sufficient to render.
  const evidence = match.criterion_evidence.find(
    (item) => item.field === "loa_m" && item.observed_value !== null,
  );
  if (evidence === undefined || evidence.observed_value === null) {
    return null;
  }
  return t.resolvedLoaText(evidence.observed_value);
}

function rudderEvidenceText(match: NativeInventoryConfirmedMatch): string | null {
  const evidence = match.criterion_evidence.find((item) => item.field === "rudder_configuration");
  if (evidence === undefined || evidence.observed_value === null) {
    return null;
  }
  return t.resolvedRudderText(rudderLabel(evidence.observed_value));
}

function hullEvidenceText(match: NativeInventoryConfirmedMatch): string | null {
  const evidence = match.criterion_evidence.find((item) => item.field === "hull_configuration");
  if (evidence === undefined || evidence.observed_value === null) {
    return null;
  }
  return t.resolvedHullText(hullLabel(evidence.observed_value));
}

function cockpitEvidenceText(match: NativeInventoryConfirmedMatch): string | null {
  const evidence = match.criterion_evidence.find((item) => item.field === "cockpit_position");
  if (evidence === undefined || evidence.observed_value === null) {
    return null;
  }
  return t.resolvedCockpitText(cockpitLabel(evidence.observed_value));
}

function deckSaloonEvidenceText(match: NativeInventoryConfirmedMatch): string | null {
  const evidence = match.criterion_evidence.find((item) => item.field === "deck_saloon");
  if (evidence === undefined || evidence.observed_value === null) {
    return null;
  }
  return t.resolvedDeckSaloonText(deckSaloonLabel(evidence.observed_value));
}

// SLICE-0085/SLICE-0086: one match's evidence text per *active* criterion
// only (never unconditionally -- a pure loa-only or hull-only match must
// never render a null/undefined draft or keel evidence line). Order mirrors
// the public canonical key order (`CANONICAL_PARAM_KEY_ORDER`): cockpit
// position, deck saloon, draft, hull form, keel, LOA, rudder.
function matchEvidenceTexts(
  match: NativeInventoryConfirmedMatch,
  req: NonNullable<typeof activeRequirement>,
): string[] {
  const texts: string[] = [];
  if (req.cockpit_position !== undefined) {
    const text = cockpitEvidenceText(match);
    if (text !== null) texts.push(text);
  }
  if (req.deck_saloon !== undefined) {
    const text = deckSaloonEvidenceText(match);
    if (text !== null) texts.push(text);
  }
  if (req.draft_max !== undefined) {
    const text = draftEvidenceText(match);
    if (text !== null) texts.push(text);
  }
  if (req.hull_configuration !== undefined) {
    const text = hullEvidenceText(match);
    if (text !== null) texts.push(text);
  }
  if (req.keel_configuration !== undefined) {
    const text = keelEvidenceText(match);
    if (text !== null) texts.push(text);
  }
  if (req.loa_min !== undefined || req.loa_max !== undefined) {
    const text = loaEvidenceText(match);
    if (text !== null) texts.push(text);
  }
  if (req.rudder_configuration !== undefined) {
    const text = rudderEvidenceText(match);
    if (text !== null) texts.push(text);
  }
  return texts;
}

// SLICE-0085: generic requirement-summary composition for any active
// combination that is not one of the three legacy fixed shapes. Builds one
// phrase per active criterion, in the accepted canonical key order, then
// joins them with the locale's own conjunction before the last phrase --
// never a second Search truth, purely a presentation-layer phrase join.
function genericRequirementSummary(req: NonNullable<typeof activeRequirement>): string {
  const phrases: string[] = [];
  if (req.cockpit_position !== undefined) {
    phrases.push(t.requirementPhraseCockpit(cockpitLabel(req.cockpit_position)));
  }
  if (req.deck_saloon !== undefined) {
    phrases.push(t.requirementPhraseDeckSaloon(deckSaloonLabel(req.deck_saloon)));
  }
  if (req.draft_max !== undefined) {
    phrases.push(t.requirementPhraseDraftMax(req.draft_max));
  }
  if (req.hull_configuration !== undefined) {
    phrases.push(t.requirementPhraseHull(hullLabel(req.hull_configuration)));
  }
  if (req.keel_configuration !== undefined) {
    phrases.push(t.requirementPhraseKeel(keelLabel(req.keel_configuration)));
  }
  if (req.loa_min !== undefined && req.loa_max !== undefined) {
    phrases.push(t.requirementPhraseLoaRange(req.loa_min, req.loa_max));
  } else if (req.loa_max !== undefined) {
    phrases.push(t.requirementPhraseLoaMax(req.loa_max));
  } else if (req.loa_min !== undefined) {
    phrases.push(t.requirementPhraseLoaMin(req.loa_min));
  }
  if (req.rudder_configuration !== undefined) {
    phrases.push(t.requirementPhraseRudder(rudderLabel(req.rudder_configuration)));
  }
  const joined =
    phrases.length <= 1
      ? (phrases[0] ?? "")
      : `${phrases.slice(0, -1).join(", ")} ${t.requirementSummaryListConjunction} ${phrases[phrases.length - 1]}`;
  return t.requirementSummaryGeneric(joined);
}

// Every entry in `data.confirmedMatches` shares the same shape (determined
// once by `usesTypedEvidenceShape` above, never per-match, per searchApi.ts's
// docstring) -- these narrow it once so the template below can iterate
// without repeating an `as` cast at each call site.
const draftOnlyMatches: DraftOnlyConfirmedMatch[] =
  !usesTypedEvidenceShape && data.kind === "ok"
    ? (data.confirmedMatches as DraftOnlyConfirmedMatch[])
    : [];
const nativeInventoryMatches: NativeInventoryConfirmedMatch[] =
  usesTypedEvidenceShape && data.kind === "ok"
    ? (data.confirmedMatches as NativeInventoryConfirmedMatch[])
    : [];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    {isCanonical && <link rel="canonical" href={canonicalUrl} />}
    <title>{t.title}</title>
  </head>
  <body>
    {
      data.kind === "invalid" ? (
        <main>
          <h1>{t.invalidTitle}</h1>
          <p>{data.message ?? t.invalidFallback}</p>
          <p>
            <a href={`/${locale}/search`}>{t.startOver}</a>
          </p>
        </main>
      ) : data.kind === "unavailable" ? (
        <main>
          <h1>{t.serviceUnavailableTitle}</h1>
          <p>{t.serviceUnavailableMessage}</p>
        </main>
      ) : (
        <main>
          <h1>{t.title}</h1>
          <p>{t.formInstructions}</p>
          <form method="get" action={`/${locale}/search`} id="hullq-search-form">
            <fieldset>
              <legend>{t.structureControlsHeading}</legend>
              <label>
                {t.hullConfigurationLabel}
                <select name="hull_configuration">
                  <option value="" selected={activeRequirement?.hull_configuration === undefined}>
                    {t.hullConfigurationAnyOption}
                  </option>
                  {SEARCH_HULL_CONFIGURATION_VALUES.map((value) => (
                    <option value={value} selected={activeRequirement?.hull_configuration === value}>
                      {hullLabel(value)}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                {t.cockpitPositionLabel}
                <select name="cockpit_position">
                  <option value="" selected={activeRequirement?.cockpit_position === undefined}>
                    {t.cockpitPositionAnyOption}
                  </option>
                  {SEARCH_COCKPIT_POSITION_VALUES.map((value) => (
                    <option value={value} selected={activeRequirement?.cockpit_position === value}>
                      {cockpitLabel(value)}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                {t.deckSaloonLabel}
                <select name="deck_saloon">
                  <option value="" selected={activeRequirement?.deck_saloon === undefined}>
                    {t.deckSaloonAnyOption}
                  </option>
                  {SEARCH_DECK_SALOON_VALUES.map((value) => (
                    <option value={value} selected={activeRequirement?.deck_saloon === value}>
                      {deckSaloonLabel(value)}
                    </option>
                  ))}
                </select>
              </label>
            </fieldset>
            <label>
              {t.draftMaxLabel}
              <input
                type="text"
                name="draft_max"
                inputmode="decimal"
                placeholder={t.draftMaxPlaceholder}
                value={activeRequirement?.draft_max ?? ""}
              />
            </label>
            <label>
              {t.keelConfigurationLabel}
              <select name="keel_configuration">
                <option value="" selected={activeRequirement?.keel_configuration === undefined}>
                  {t.keelConfigurationAnyOption}
                </option>
                {SEARCH_KEEL_CONFIGURATION_VALUES.map((value) => (
                  <option value={value} selected={activeRequirement?.keel_configuration === value}>
                    {keelLabel(value)}
                  </option>
                ))}
              </select>
            </label>
            <label>
              {t.loaMinLabel}
              <input
                type="text"
                name="loa_min"
                inputmode="decimal"
                placeholder={t.loaMinPlaceholder}
                value={activeRequirement?.loa_min ?? ""}
              />
            </label>
            <label>
              {t.loaMaxLabel}
              <input
                type="text"
                name="loa_max"
                inputmode="decimal"
                placeholder={t.loaMaxPlaceholder}
                value={activeRequirement?.loa_max ?? ""}
              />
            </label>
            <label>
              {t.rudderConfigurationLabel}
              <select name="rudder_configuration">
                <option value="" selected={activeRequirement?.rudder_configuration === undefined}>
                  {t.rudderConfigurationAnyOption}
                </option>
                {SEARCH_RUDDER_CONFIGURATION_VALUES.map((value) => (
                  <option
                    value={value}
                    selected={activeRequirement?.rudder_configuration === value}
                  >
                    {rudderLabel(value)}
                  </option>
                ))}
              </select>
            </label>
            <button type="submit">{t.submit}</button>
          </form>
          <script>
            // SLICE-0056: pure HTML cannot represent "buyer left this
            // criterion unset" as an omitted GET query parameter -- an
            // untouched <select>/<input> still submits `name=<empty
            // value>`. This only disables fields `isUntouchedFormFieldValue`
            // identifies as genuinely untouched, immediately before the
            // browser's own native submission, so they are excluded from
            // it -- see `../lib/searchFormOmission.ts` for the full
            // rationale (including why a whitespace-only value is
            // deliberately NOT treated as untouched). This never builds a
            // URL, canonicalizes a value, validates input or evaluates
            // Search truth itself (all still exclusively FastAPI's, per
            // Required Behavior §B/§J) -- not a client-side Search engine.
            import { isUntouchedFormFieldValue } from "../lib/searchFormOmission";

            const form = document.getElementById("hullq-search-form");
            if (form instanceof HTMLFormElement) {
              form.addEventListener("submit", () => {
                for (const element of form.elements) {
                  if (
                    (element instanceof HTMLInputElement || element instanceof HTMLSelectElement) &&
                    element.name &&
                    isUntouchedFormFieldValue(element.value)
                  ) {
                    element.disabled = true;
                  }
                }
              });
            }
          </script>

          {activeRequirement !== null && (
            <section aria-label="search results" data-hullq-locale={locale}>
              <p>
                {isLegacySummaryShape
                  ? activeRequirement.draft_max !== undefined && activeRequirement.keel_configuration !== undefined
                    ? t.requirementSummaryMixed(activeRequirement.draft_max, keelLabel(activeRequirement.keel_configuration))
                    : activeRequirement.keel_configuration !== undefined
                      ? t.requirementSummaryKeelOnly(keelLabel(activeRequirement.keel_configuration))
                      : // isLegacySummaryShape + keel/loa/rudder all undefined here implies
                        // draft_max is the one active criterion (FastAPI's own RESULT
                        // invariant: "at least one active criterion") -- TypeScript's plain
                        // all-optional SearchActiveRequirement shape (SLICE-0085) cannot
                        // express that discriminated guarantee structurally.
                        t.requirementSummary(activeRequirement.draft_max as string)
                  : genericRequirementSummary(activeRequirement)}
              </p>

              <h2>
                {t.confirmedHeading} ({data.confirmedMatchCount})
              </h2>
              {data.confirmedMatchCount === 0 ? (
                <p>{isKeelActive ? t.noConfirmedMatchesGeneric : t.noConfirmedMatches}</p>
              ) : isKeelActive ? (
                <ul>
                  {nativeInventoryMatches.map((match) => (
                    <li>
                      <a
                        href={`/listings/${match.native_listing_id}?ds=${encodeURIComponent(match.discovery_token)}`}
                      >
                        {t.viewListing}: {match.native_listing_id}
                      </a>
                      {matchEvidenceTexts(match, activeRequirement).map((text) => (
                        <>
                          {" — "}
                          {text}
                        </>
                      ))}
                      {" — "}
                      <span aria-label="freshness status">
                        {match.freshness_status === "DUE_FOR_CONFIRMATION"
                          ? t.freshnessDueLabel
                          : t.freshnessConfirmedLabel}
                      </span>
                      {match.freshness_status === "DUE_FOR_CONFIRMATION" && (
                        <p aria-label="freshness due note">{t.freshnessDueNote}</p>
                      )}
                      {
                        // PR #349 independent-review Finding D: the design/
                        // configuration-level evidence FastAPI already
                        // returns alongside the concrete evidence above --
                        // rendered distinctly, never merged with/implied by
                        // the concrete PhysicalBoat claim lines (contract:
                        // "design truth separated from physical-offer
                        // truth", docs/PRODUCT_UX_PRINCIPLES.md §15 minimum
                        // 5). Every evaluated configuration is listed with
                        // its OWN truth -- never implying every NamedVariant
                        // matches merely because the listing overall
                        // confirmed via a different one, and a genuinely
                        // UNKNOWN per-criterion evaluation is shown as
                        // UNKNOWN, never silently dropped or upgraded.
                        match.design_configuration_evidence.length > 0 && (
                          <div aria-label="design configuration evidence">
                            <p>{t.designEvidenceHeading}</p>
                            <ul>
                              {match.design_configuration_evidence.map((configEvidence) => (
                                <li>
                                  {t.designEvidenceConfigurationLabel}{" "}
                                  <code>{configEvidence.configuration_id}</code>{" "}
                                  ({truthLabel(configEvidence.truth)})
                                  <ul>
                                    {configEvidence.criterion_evidence.map((evidence) => (
                                      <li>
                                        {describeCriterion(evidence.criterion)}:{" "}
                                        {truthLabel(evidence.truth)}
                                        {evidence.observed_value !== null && (
                                          <> — {evidence.observed_value}</>
                                        )}
                                      </li>
                                    ))}
                                  </ul>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )
                      }
                      {" "}
                      <button
                        type="button"
                        data-shortlist-toggle
                        data-native-listing-id={match.native_listing_id}
                      >
                        {st.saveLabel}
                      </button>
                    </li>
                  ))}
                </ul>
              ) : (
                <ul>
                  {draftOnlyMatches.map((match) => (
                    <li>
                      <a
                        href={`/listings/${match.native_listing_id}?ds=${encodeURIComponent(match.discovery_token)}`}
                      >
                        {t.viewListing}: {match.native_listing_id}
                      </a>{" "}
                      &mdash; {t.resolvedDraftText(match.resolved_draft_m)}
                      {" — "}
                      <span aria-label="freshness status">
                        {match.freshness_status === "DUE_FOR_CONFIRMATION"
                          ? t.freshnessDueLabel
                          : t.freshnessConfirmedLabel}
                      </span>
                      {match.freshness_status === "DUE_FOR_CONFIRMATION" && (
                        <p aria-label="freshness due note">{t.freshnessDueNote}</p>
                      )}
                      {" "}
                      <button
                        type="button"
                        data-shortlist-toggle
                        data-native-listing-id={match.native_listing_id}
                      >
                        {st.saveLabel}
                      </button>
                    </li>
                  ))}
                </ul>
              )}

              {data.insufficientDataCount > 0 && (
                <p aria-label="insufficient data">
                  {isKeelActive
                    ? t.insufficientDataTextGeneric(data.insufficientDataCount)
                    : t.insufficientDataText(data.insufficientDataCount)}
                </p>
              )}

              {
                // Review amendment Finding A (HIGH, buyer truth regression):
                // the SLICE-0057 sensitivity forms below submit ONLY
                // current_draft_max/current_keel_configuration -- they have
                // no field for loa_min/loa_max/rudder_configuration at all.
                // If ANY SLICE-0085 criterion is also active, posting one of
                // these forms would silently omit it from the "current"
                // state `hullq.application.search_sensitivity.
                // evaluate_requirement_sensitivity` evaluates against,
                // producing a plausible-looking but actually-unrelated
                // delta for a Search the buyer never ran (contract
                // violation: "preserve all original-only active-sensitivity
                // flows ... never produce a false delta"). Rather than
                // teach every form a new hidden field per future criterion
                // (which would only re-create this exact bug for the next
                // one), the forms are gated on `isLegacySummaryShape` --
                // sensitivity is offered only when draft_max/keel_configuration
                // are the ONLY active criteria (byte-identical to the
                // original two-criterion behavior); otherwise a truthful,
                // localized explanation is shown instead of silently wrong
                // forms or silently absent controls.
                activeRequirement.draft_max !== undefined ||
                activeRequirement.keel_configuration !== undefined ? (
                  isLegacySummaryShape ? (
                    <section aria-label="requirement sensitivity">
                      <p>{t.sensitivityFormNote}</p>
                      {activeRequirement.draft_max !== undefined && (
                        <form method="post" action={`/${locale}/search/sensitivity`}>
                          <input
                            type="hidden"
                            name="current_draft_max"
                            value={activeRequirement.draft_max}
                          />
                          {activeRequirement.keel_configuration !== undefined && (
                            <input
                              type="hidden"
                              name="current_keel_configuration"
                              value={activeRequirement.keel_configuration}
                            />
                          )}
                          <input type="hidden" name="changed_criterion" value="draft_max" />
                          <label>
                            {t.sensitivityAlternativeDraftLabel}
                            <input
                              type="text"
                              name="changed_value"
                              inputmode="decimal"
                              placeholder={t.draftMaxPlaceholder}
                            />
                          </label>
                          <button type="submit">{t.sensitivityDraftSubmitLabel}</button>
                        </form>
                      )}
                      {activeRequirement.keel_configuration !== undefined && (
                        <form method="post" action={`/${locale}/search/sensitivity`}>
                          {activeRequirement.draft_max !== undefined && (
                            <input
                              type="hidden"
                              name="current_draft_max"
                              value={activeRequirement.draft_max}
                            />
                          )}
                          <input
                            type="hidden"
                            name="current_keel_configuration"
                            value={activeRequirement.keel_configuration}
                          />
                          <input type="hidden" name="changed_criterion" value="keel_configuration" />
                          <label>
                            {t.sensitivityAlternativeKeelLabel}
                            <select name="changed_value">
                              {SEARCH_KEEL_CONFIGURATION_VALUES.map((value) => (
                                <option value={value}>{keelLabel(value)}</option>
                              ))}
                            </select>
                          </label>
                          <button type="submit">{t.sensitivityKeelSubmitLabel}</button>
                        </form>
                      )}
                    </section>
                  ) : (
                    <section aria-label="requirement sensitivity unavailable">
                      <p>{t.sensitivityUnavailableWithNewCriteria}</p>
                    </section>
                  )
                ) : null
              }
            </section>
          )}

          <script>
            // SLICE-0058: wires every add/remove shortlist button rendered
            // above to the buyer's browser-local shortlist. Only an
            // explicit click ever mutates membership -- see
            // `../lib/shortlistButtons.ts`'s module docstring. The active
            // locale is read from the results section's own data attribute
            // (never from a second guess at the URL) so the button text
            // matches the page FastAPI/Astro actually rendered.
            import { initShortlistButtons } from "../lib/shortlistButtons";
            import { shortlistText, type SupportedLocale } from "../lib/shortlistText";

            const resultsSection = document.querySelector<HTMLElement>("[data-hullq-locale]");
            const locale = (resultsSection?.dataset.hullqLocale as SupportedLocale | undefined) ?? "en";
            const st = shortlistText[locale] ?? shortlistText.en;
            initShortlistButtons(document, { saveLabel: st.saveLabel, savedLabel: st.savedLabel });
          </script>
        </main>
      )
    }
  </body>
</html>
