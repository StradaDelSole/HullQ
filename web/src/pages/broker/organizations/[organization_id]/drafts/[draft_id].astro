---
// SLICE-0061: one professional listing draft's private edit/save/reopen
// surface (contract §9). Renders only an owned, authorized-Organization
// draft; a foreign/unknown draft_id or unauthorized Organization is one
// identical non-enumerating not-found state (contract §3.3/§7) -- this page
// never tries to distinguish them. There is no Publish/Withdraw/Reconfirm/
// media/Search-fit/public-preview action anywhere on this page (contract
// §9): this is pre-market private workspace data only.
//
// The POST handler below is the SLICE-0061 contract §8 CSRF proxy for
// "save": see professionalDraftApi.ts's module docstring for why it
// forwards the browser's real Origin rather than substituting a trusted
// one. Astro formats/forwards form values here but is never the
// authoritative field validator, Organization-authorizer or concurrency
// engine -- every field/version decision below is exactly what FastAPI
// returned.
export const prerender = false;

import {
  type ProfessionalDraftPayloadInput,
  type ProfessionalListingDraft,
  fetchProfessionalDraft,
  updateProfessionalDraft,
} from "../../../../../lib/professionalDraftApi";
import { AUTH0_MFA_STEP_UP_ACR_VALUE } from "../../../../../lib/authConstants";
import { fetchBrokerContext } from "../../../../../lib/brokerApi";

const organizationId = Astro.params.organization_id ?? "";
const draftId = Astro.params.draft_id ?? "";
const apiBaseUrl = process.env.HULLQ_API_BASE_URL ?? "http://127.0.0.1:8000";
const cookieHeader = Astro.request.headers.get("cookie");
const originHeader = Astro.request.headers.get("origin");

Astro.response.headers.set("X-Robots-Tag", "noindex");
Astro.response.headers.set("Cache-Control", "private, no-store");

type FormFieldKey = keyof ProfessionalDraftPayloadInput;

function readOptionalField(formData: FormData, key: FormFieldKey): string | undefined {
  const raw = formData.get(key);
  if (typeof raw !== "string") return undefined;
  const trimmed = raw.trim();
  return trimmed === "" ? undefined : trimmed;
}

function payloadFromForm(formData: FormData): ProfessionalDraftPayloadInput {
  const payload: ProfessionalDraftPayloadInput = {};

  const reference = readOptionalField(formData, "broker_listing_reference");
  if (reference !== undefined) payload.broker_listing_reference = reference;

  const brand = readOptionalField(formData, "physical_boat.marketed_brand_claim");
  if (brand !== undefined) payload["physical_boat.marketed_brand_claim"] = brand;

  const model = readOptionalField(formData, "physical_boat.model_designation_claim");
  if (model !== undefined) payload["physical_boat.model_designation_claim"] = model;

  const buildYearRaw = readOptionalField(formData, "physical_boat.build_year");
  if (buildYearRaw !== undefined) {
    const parsed = Number.parseInt(buildYearRaw, 10);
    if (Number.isFinite(parsed)) payload["physical_boat.build_year"] = parsed;
  }

  const boatName = readOptionalField(formData, "physical_boat.boat_name");
  if (boatName !== undefined) payload["physical_boat.boat_name"] = boatName;

  const priceMode = readOptionalField(formData, "listing_offer.asking_price_mode");
  if (priceMode === "AMOUNT" || priceMode === "POA") {
    payload["listing_offer.asking_price_mode"] = priceMode;
  }
  // Contract §4: asking_price_amount must be absent when mode is POA --
  // omitted here by construction rather than sent and rejected.
  if (priceMode !== "POA") {
    const amount = readOptionalField(formData, "listing_offer.asking_price_amount");
    if (amount !== undefined) payload["listing_offer.asking_price_amount"] = amount;
  }

  const currency = readOptionalField(formData, "listing_offer.currency");
  if (currency !== undefined) payload["listing_offer.currency"] = currency.toUpperCase();

  const country = readOptionalField(formData, "listing_offer.location_country");
  if (country !== undefined) payload["listing_offer.location_country"] = country.toUpperCase();

  const region = readOptionalField(formData, "listing_offer.location_region");
  if (region !== undefined) payload["listing_offer.location_region"] = region;

  return payload;
}

type SaveOutcome = "none" | "saved" | "conflict" | "invalid";
let saveOutcome: SaveOutcome = "none";

if (Astro.request.method === "POST" && organizationId && draftId) {
  const formData = await Astro.request.formData();
  const expectedVersionRaw = formData.get("expected_version");
  const expectedVersion =
    typeof expectedVersionRaw === "string" ? Number.parseInt(expectedVersionRaw, 10) : NaN;
  if (Number.isFinite(expectedVersion)) {
    const payload = payloadFromForm(formData);
    const updateResult = await updateProfessionalDraft(
      apiBaseUrl,
      organizationId,
      draftId,
      cookieHeader,
      originHeader,
      expectedVersion,
      payload,
    );
    if (updateResult.kind === "ok") saveOutcome = "saved";
    else if (updateResult.kind === "conflict") saveOutcome = "conflict";
    else if (updateResult.kind === "invalid") saveOutcome = "invalid";
    // Every other update outcome falls through to the read below, which
    // independently resolves to the identical state.
  }
}

// Always re-read the authoritative persisted state after a POST -- the
// rendered form must reflect exactly what FastAPI actually stored, never
// what the browser merely submitted (contract §7/§9: a stale-save conflict
// must be visible, not silently overwritten).
const readResult =
  organizationId && draftId
    ? await fetchProfessionalDraft(apiBaseUrl, organizationId, draftId, cookieHeader)
    : ({ kind: "not_found" } as const);

if (readResult.kind === "not_found") {
  Astro.response.status = 404;
} else if (readResult.kind === "mfa_required") {
  Astro.response.status = 403;
} else if (readResult.kind === "publisher_role_required") {
  Astro.response.status = 403;
}

const draft: ProfessionalListingDraft | null = readResult.kind === "ok" ? readResult.data : null;
const nextPath = `/broker/organizations/${organizationId}/drafts/${draftId}`;
const loginUrl = `${apiBaseUrl}/api/auth/login?next=${encodeURIComponent(nextPath)}`;
const stepUpUrl = `${loginUrl}&acr_values=${encodeURIComponent(AUTH0_MFA_STEP_UP_ACR_VALUE)}`;

// SLICE-0062 (recovery contract §4): the current AccountId is fetched only
// as browser-local recovery *scoping* metadata, never as authorization
// evidence -- the draft was already authorized above by `fetchProfessionalDraft`.
// If this call fails for any reason, `accountId` stays empty and the inline
// script below leaves the recovery buffer wired off entirely rather than
// guessing a scope (ordinary server-backed drafting is unaffected either way).
const brokerContextResult = draft ? await fetchBrokerContext(apiBaseUrl, cookieHeader) : null;
const accountId = brokerContextResult?.kind === "ok" ? brokerContextResult.data.account_id : "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>HullQ Broker Workspace — Listing Draft</title>
  </head>
  <body>
    <main>
      <h1>Professional listing draft</h1>
      <p>
        <strong>Draft &mdash; not public.</strong> This is private workspace data only. There is
        no publish action here.
      </p>
      {
        readResult.kind === "unauthenticated" ? (
          <p>
            Please <a href={loginUrl}>log in</a> to view this draft.
          </p>
        ) : readResult.kind === "not_found" ? (
          <p>This draft is not available.</p>
        ) : readResult.kind === "mfa_required" ? (
          <>
            <p>This Organization membership requires multi-factor authentication.</p>
            <a href={stepUpUrl}>Verify and continue</a>
          </>
        ) : readResult.kind === "publisher_role_required" ? (
          <p>
            Your current membership in this Organization does not include the PUBLISHER role
            required to view or edit listing drafts.
          </p>
        ) : (
          <>
            {saveOutcome === "saved" && <p>Saved.</p>}
            {saveOutcome === "conflict" && (
              <p>
                This draft changed elsewhere since you loaded it (current version {draft?.version}
                ). Your last edits were not saved -- please re-enter them below.
              </p>
            )}
            {saveOutcome === "invalid" && (
              <p>Some values could not be saved. Please check the fields below.</p>
            )}
            <p>Version: {draft?.version}</p>
            <div
              id="draft-recovery-banner"
              data-account-id={accountId}
              data-organization-id={organizationId}
              data-draft-id={draftId}
              data-server-version={draft?.version ?? ""}
              data-save-outcome={saveOutcome}
            />
            <form method="POST" id="draft-form">
              <input type="hidden" name="expected_version" value={draft?.version} />
              <p>
                <label>
                  Broker listing reference
                  <input
                    type="text"
                    name="broker_listing_reference"
                    value={draft?.broker_listing_reference ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Marketed brand claim
                  <input
                    type="text"
                    name="physical_boat.marketed_brand_claim"
                    value={draft?.["physical_boat.marketed_brand_claim"] ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Model designation claim
                  <input
                    type="text"
                    name="physical_boat.model_designation_claim"
                    value={draft?.["physical_boat.model_designation_claim"] ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Build year
                  <input
                    type="number"
                    name="physical_boat.build_year"
                    value={draft?.["physical_boat.build_year"] ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Boat name
                  <input
                    type="text"
                    name="physical_boat.boat_name"
                    value={draft?.["physical_boat.boat_name"] ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Asking price mode
                  <select name="listing_offer.asking_price_mode">
                    <option value="" selected={!draft?.["listing_offer.asking_price_mode"]}>
                      -- unset --
                    </option>
                    <option
                      value="AMOUNT"
                      selected={draft?.["listing_offer.asking_price_mode"] === "AMOUNT"}
                    >
                      Amount
                    </option>
                    <option
                      value="POA"
                      selected={draft?.["listing_offer.asking_price_mode"] === "POA"}
                    >
                      Price on application
                    </option>
                  </select>
                </label>
              </p>
              <p>
                <label>
                  Asking price amount
                  <input
                    type="text"
                    name="listing_offer.asking_price_amount"
                    value={draft?.["listing_offer.asking_price_amount"] ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Currency
                  <input
                    type="text"
                    name="listing_offer.currency"
                    maxlength="3"
                    value={draft?.["listing_offer.currency"] ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Location country
                  <input
                    type="text"
                    name="listing_offer.location_country"
                    maxlength="2"
                    value={draft?.["listing_offer.location_country"] ?? ""}
                  />
                </label>
              </p>
              <p>
                <label>
                  Location region
                  <input
                    type="text"
                    name="listing_offer.location_region"
                    value={draft?.["listing_offer.location_region"] ?? ""}
                  />
                </label>
              </p>
              <button type="submit">Save</button>
            </form>
            <p>
              <a href={`/broker/organizations/${organizationId}/drafts`}>Back to drafts</a>
            </p>
            <script>
              // SLICE-0062: wires this page's bounded browser-local recovery
              // buffer -- see `../../../../../lib/professionalDraftRecovery.ts`'s
              // module docstring. A successful save (saveOutcome === "saved")
              // clears the now-stale local envelope before the ordinary
              // restore decision runs (contract §H); every other outcome
              // (none/conflict/invalid) leaves any existing local envelope
              // exactly as captured (contract §G) and lets
              // `initProfessionalDraftRecovery` decide same-version-restore
              // vs. newer-server-version conflict against the current
              // rendered version.
              import {
                clearRecoveryEnvelope,
                initProfessionalDraftRecovery,
              } from "../../../../../lib/professionalDraftRecovery";

              const bannerEl = document.getElementById("draft-recovery-banner");
              const formEl = document.getElementById("draft-form");

              if (bannerEl instanceof HTMLElement && formEl instanceof HTMLFormElement) {
                const accountId = bannerEl.dataset.accountId ?? "";
                const organizationId = bannerEl.dataset.organizationId ?? "";
                const draftId = bannerEl.dataset.draftId ?? "";
                const serverVersion = Number.parseInt(bannerEl.dataset.serverVersion ?? "", 10);
                const saveOutcome = bannerEl.dataset.saveOutcome ?? "none";

                if (accountId && organizationId && draftId && Number.isFinite(serverVersion)) {
                  const scope = { accountId, organizationId, draftId };
                  if (saveOutcome === "saved") {
                    clearRecoveryEnvelope(window.localStorage, scope);
                  }
                  initProfessionalDraftRecovery(formEl, bannerEl, scope, serverVersion, window.localStorage);
                }
              }
            </script>
          </>
        )
      }
    </main>
  </body>
</html>
