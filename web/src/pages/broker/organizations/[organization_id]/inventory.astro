---
// SLICE-0060/SLICE-0064: the private Organization inventory overview surface
// (contract §10/§11/§12), now also the required v0.1 action surface for
// publish/withdraw/reconfirm on an already-existing NativeListing
// (PROFESSIONAL_INVENTORY_LIFECYCLE_CONTROLS_CONTRACT.v0.1 §13). This page
// still creates no NativeListing, promotes no draft and edits no offer --
// only the three accepted lifecycle/freshness operations below.
//
// unauthenticated             -> login path
// unknown/unauthorized org    -> ordinary not-found (non-enumerating,
//                                identical to the existing Organization
//                                workspace landing's own boundary)
// privileged membership,
//   no validated MFA          -> blocked/step-up prompt
// malformed cursor            -> bounded 400-equivalent recovery state
// service failure             -> distinct "try again" state, never rendered
//                                as an empty inventory
// authorized                  -> factual current DRAFT/ACTIVE/WITHDRAWN
//                                inventory, current offer/freshness/
//                                public-link facts, bounded pagination,
//                                state-appropriate Publish/Withdraw/
//                                Reconfirm controls
//
// Every fact here comes from FastAPI via `fetchOrganizationInventory`; this
// page never queries PostgreSQL directly and never infers lifecycle,
// ownership, offer, freshness or public-link eligibility on its own.
//
// The POST handler below is the SLICE-0064 contract §7 CSRF proxy for
// publish/withdraw/reconfirm: the browser's own same-origin form submission
// is the only thing that ever calls FastAPI's state-changing inventory
// endpoints (see `brokerApi.ts`'s module docstring for why that boundary
// forwards the browser's real Origin rather than substituting a trusted
// one). After every action this page re-reads the authoritative inventory
// page from FastAPI (contract §I): the rendered result is always exactly
// what was just durably read back, never a client-invented success.
export const prerender = false;

import {
  fetchOrganizationInventory,
  publishOrganizationListing,
  withdrawOrganizationListing,
  reconfirmOrganizationListing,
} from "../../../../lib/brokerApi";
import { AUTH0_MFA_STEP_UP_ACR_VALUE } from "../../../../lib/authConstants";

const organizationId = Astro.params.organization_id;
const apiBaseUrl = process.env.HULLQ_API_BASE_URL ?? "http://127.0.0.1:8000";
const cookieHeader = Astro.request.headers.get("cookie");
const originHeader = Astro.request.headers.get("origin");
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

Astro.response.headers.set("X-Robots-Tag", "noindex");
// This page renders one signed-in Account's own authorized Organization
// inventory: never reusable by a browser/shared cache across Accounts or
// after logout (same boundary already accepted for the Organization
// workspace landing).
Astro.response.headers.set("Cache-Control", "private, no-store");

type ActionOutcome =
  | "none"
  | "published"
  | "withdrawn"
  | "reconfirmed"
  | "unauthenticated"
  | "listing_not_found"
  | "mfa_required"
  | "denied"
  | "incomplete_listing"
  | "state_conflict"
  | "invalid_operation_id"
  | "operation_id_conflict"
  | "action_failed";

let actionOutcome: ActionOutcome = "none";
let deniedReason = "";

if (Astro.request.method === "POST" && organizationId) {
  const formData = await Astro.request.formData();
  const action = formData.get("action");
  const nativeListingId = formData.get("native_listing_id");

  if (
    typeof nativeListingId === "string" &&
    nativeListingId &&
    (action === "publish" || action === "withdraw" || action === "reconfirm")
  ) {
    if (action === "publish") {
      const result = await publishOrganizationListing(
        apiBaseUrl,
        organizationId,
        nativeListingId,
        cookieHeader,
        originHeader,
      );
      if (result.kind === "ok") actionOutcome = "published";
      else if (result.kind === "denied") {
        actionOutcome = "denied";
        deniedReason = result.reason;
      } else if (result.kind === "incomplete_listing") actionOutcome = "incomplete_listing";
      else if (result.kind === "state_conflict") actionOutcome = "state_conflict";
      else if (result.kind === "not_found") actionOutcome = "listing_not_found";
      else if (result.kind === "mfa_required") actionOutcome = "mfa_required";
      else if (result.kind === "unauthenticated") actionOutcome = "unauthenticated";
      else actionOutcome = "action_failed"; // service_error only
    } else if (action === "withdraw") {
      const result = await withdrawOrganizationListing(
        apiBaseUrl,
        organizationId,
        nativeListingId,
        cookieHeader,
        originHeader,
      );
      if (result.kind === "ok") actionOutcome = "withdrawn";
      else if (result.kind === "denied") {
        actionOutcome = "denied";
        deniedReason = result.reason;
      } else if (result.kind === "state_conflict") actionOutcome = "state_conflict";
      else if (result.kind === "not_found") actionOutcome = "listing_not_found";
      else if (result.kind === "mfa_required") actionOutcome = "mfa_required";
      else if (result.kind === "unauthenticated") actionOutcome = "unauthenticated";
      else actionOutcome = "action_failed"; // service_error only
    } else {
      const confirmationId = formData.get("confirmation_id");
      if (typeof confirmationId === "string" && confirmationId) {
        const result = await reconfirmOrganizationListing(
          apiBaseUrl,
          organizationId,
          nativeListingId,
          confirmationId,
          cookieHeader,
          originHeader,
        );
        if (result.kind === "ok") actionOutcome = "reconfirmed";
        else if (result.kind === "denied") {
          actionOutcome = "denied";
          deniedReason = result.reason;
        } else if (result.kind === "invalid_operation_id") actionOutcome = "invalid_operation_id";
        else if (result.kind === "state_conflict") actionOutcome = "state_conflict";
        else if (result.kind === "operation_id_conflict") actionOutcome = "operation_id_conflict";
        else if (result.kind === "not_found") actionOutcome = "listing_not_found";
        else if (result.kind === "mfa_required") actionOutcome = "mfa_required";
        else if (result.kind === "unauthenticated") actionOutcome = "unauthenticated";
        else actionOutcome = "action_failed"; // service_error only
      } else {
        actionOutcome = "invalid_operation_id";
      }
    }
  }
  // Every outcome falls through to the ordinary GET rendering below, which
  // always re-reads the authoritative current state (contract §I) rather
  // than trusting what was just submitted.
}

const result = organizationId
  ? await fetchOrganizationInventory(apiBaseUrl, organizationId, cookieHeader, { cursor })
  : ({ kind: "not_found" } as const);

if (result.kind === "not_found") {
  Astro.response.status = 404;
} else if (result.kind === "mfa_required") {
  Astro.response.status = 403;
} else if (result.kind === "invalid_cursor") {
  Astro.response.status = 400;
} else if (result.kind === "service_error") {
  Astro.response.status = 503;
}

const nextPath = `/broker/organizations/${organizationId ?? ""}/inventory`;
const loginUrl = `${apiBaseUrl}/api/auth/login?next=${encodeURIComponent(nextPath)}`;
const stepUpUrl = `${loginUrl}&acr_values=${encodeURIComponent(AUTH0_MFA_STEP_UP_ACR_VALUE)}`;

function offerText(offer: { kind: string; amount: string | null; currency: string | null }): string {
  if (offer.kind === "AMOUNT") {
    return `${offer.amount} ${offer.currency}`;
  }
  if (offer.kind === "POA") {
    return "Price on application";
  }
  return "No current offer";
}

function freshnessText(status: string, lastConfirmedAt: string | null): string {
  if (lastConfirmedAt === null) {
    return status;
  }
  return `${status} (last confirmed ${lastConfirmedAt})`;
}

const actionOutcomeText: Record<ActionOutcome, string | null> = {
  none: null,
  published: "Published.",
  withdrawn: "Withdrawn.",
  reconfirmed: "Reconfirmed.",
  unauthenticated: "Please log in to do this.",
  // Contract §4: a foreign-Organization listing and an unknown listing_id
  // must be indistinguishable -- this text never reveals which case
  // occurred, only that the action could not find that listing here.
  listing_not_found: "This listing isn't available here.",
  mfa_required: "Additional verification is required before you can do this.",
  denied: `Not allowed${deniedReason ? ` (${deniedReason})` : ""}.`,
  incomplete_listing: "This listing is not complete enough to publish yet.",
  state_conflict: "This listing's state has already changed -- please review its current status below.",
  invalid_operation_id: "That reconfirm request wasn't valid. Please try again.",
  operation_id_conflict: "That reconfirm request could not be applied. Please try again.",
  action_failed: "Something went wrong. Please try again.",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>HullQ Broker Workspace — Inventory</title>
  </head>
  <body>
    <main>
      {
        result.kind === "unauthenticated" ? (
          <>
            <h1>Broker Workspace</h1>
            <p>
              Please <a href={loginUrl}>log in</a> to access this Organization's inventory.
            </p>
          </>
        ) : result.kind === "not_found" ? (
          <>
            <h1>Not found</h1>
            <p>This Organization inventory is not available.</p>
          </>
        ) : result.kind === "mfa_required" ? (
          <>
            <h1>Additional verification required</h1>
            <p>This Organization membership requires multi-factor authentication.</p>
            <a href={stepUpUrl}>Verify and continue</a>
          </>
        ) : result.kind === "invalid_cursor" ? (
          <>
            <h1>Invalid inventory link</h1>
            <p>
              This inventory continuation link isn't valid. Return to{" "}
              <a href={`/broker/organizations/${organizationId}/inventory`}>the first page</a>.
            </p>
          </>
        ) : result.kind === "service_error" ? (
          <>
            <h1>Inventory temporarily unavailable</h1>
            <p>Something went wrong loading this Organization's inventory. Please try again.</p>
          </>
        ) : (
          <>
            <h1>Organization inventory</h1>
            <p>
              <a href={`/broker/organizations/${organizationId}`}>Back to workspace</a>
            </p>
            {actionOutcomeText[actionOutcome] && <p>{actionOutcomeText[actionOutcome]}</p>}
            {result.data.items.length === 0 ? (
              <p>This Organization has no listings yet.</p>
            ) : (
              <table>
                <thead>
                  <tr>
                    <th>Listing</th>
                    <th>Broker reference</th>
                    <th>Lifecycle</th>
                    <th>Current offer</th>
                    <th>Freshness</th>
                    <th>Created</th>
                    <th>Public link</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {result.data.items.map((item) => (
                    <tr>
                      <td>{item.native_listing_id}</td>
                      <td>{item.broker_listing_reference ?? "—"}</td>
                      <td>{item.lifecycle_state}</td>
                      <td>{offerText(item.offer)}</td>
                      <td>{freshnessText(item.freshness_status, item.last_confirmed_at)}</td>
                      <td>{item.created_at}</td>
                      <td>
                        {item.is_publicly_listed ? (
                          <a href={`/listings/${encodeURIComponent(item.native_listing_id)}`}>
                            View public listing
                          </a>
                        ) : (
                          "—"
                        )}
                      </td>
                      <td>
                        {item.lifecycle_state === "DRAFT" && (
                          <form method="POST">
                            <input type="hidden" name="native_listing_id" value={item.native_listing_id} />
                            <input type="hidden" name="action" value="publish" />
                            <button type="submit">Publish</button>
                          </form>
                        )}
                        {item.lifecycle_state === "ACTIVE" && (
                          <>
                            <form method="POST">
                              <input type="hidden" name="native_listing_id" value={item.native_listing_id} />
                              <input type="hidden" name="action" value="withdraw" />
                              <button type="submit">Withdraw</button>
                            </form>
                            <form method="POST">
                              <input type="hidden" name="native_listing_id" value={item.native_listing_id} />
                              <input type="hidden" name="action" value="reconfirm" />
                              <input type="hidden" name="confirmation_id" value={crypto.randomUUID()} />
                              <button type="submit">Reconfirm</button>
                            </form>
                          </>
                        )}
                        {item.lifecycle_state === "WITHDRAWN" && "—"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {result.data.next_cursor ? (
              <p>
                <a
                  href={`/broker/organizations/${organizationId}/inventory?cursor=${encodeURIComponent(
                    result.data.next_cursor,
                  )}`}
                >
                  Next page
                </a>
              </p>
            ) : null}
          </>
        )
      }
    </main>
  </body>
</html>
