---
// SLICE-0051: English locale-prefixed Search surface. Response-mutating
// decisions (redirect/status) must happen here, in the top-level page's own
// frontmatter -- see web/src/lib/searchPageData.ts's docstring for why.
// Presentation itself lives in the shared SearchPageBody.astro component.
export const prerender = false;
import SearchPageBody from "../../components/SearchPageBody.astro";
import { loadSearchPageData } from "../../lib/searchPageData";

const locale = "en" as const;
// `process.env`, not `import.meta.env`: the latter is statically replaced by
// Vite at build time, so it can never see a value only known at server
// start time (matches the existing listing page's own convention).
const apiBaseUrl = process.env.HULLQ_API_BASE_URL ?? "http://127.0.0.1:8000";

// SLICE-0051 item L: every Search surface is noindex, including a canonical
// 200 result page -- set unconditionally, before any redirect/error branch.
Astro.response.headers.set("X-Robots-Tag", "noindex");

const queryString = Astro.url.search.replace(/^\?/, "");
const data = await loadSearchPageData(apiBaseUrl, locale, queryString);

if (data.kind === "redirect") {
  return Astro.redirect(data.location, 308);
}
if (data.kind === "invalid") {
  Astro.response.status = 400;
} else if (data.kind === "unavailable") {
  // Amendment review Finding 6: a backend/network failure is not a
  // malformed buyer requirement -- it gets its own 5xx status, never 400.
  Astro.response.status = 503;
}

const canonicalPath =
  data.kind === "ok" && data.activeRequirement !== null
    ? `/${locale}/search?draft_max=${data.activeRequirement.draft_max}`
    : `/${locale}/search`;
const canonicalUrl = new URL(canonicalPath, Astro.url).toString();
---

<SearchPageBody locale={locale} data={data} canonicalUrl={canonicalUrl} />
